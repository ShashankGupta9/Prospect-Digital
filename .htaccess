# ==========================================================================
# Prospect Digital — Production & Local Apache Configuration
# Fully compatible with Hostinger (domain root) and XAMPP (subfolder)
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # Block direct web access to backend data & includes folders
    # ------------------------------------------------------------------
    RewriteRule ^(?:includes|data)/ - [F,L]

    # ------------------------------------------------------------------
    # Sitemap
    # ------------------------------------------------------------------
    RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]


    # ------------------------------------------------------------------
    # Redirect direct .php URLs to clean URLs
    # Extracts the exact request path from %{THE_REQUEST} so it works
    # dynamically at domain root (Hostinger) or subfolder (e.g. /prospect-digital/)
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)/index\.php(?:[?\s]|$) [NC]
    RewriteRule ^ %1/ [R=301,L]

    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.php(?:[?\s]|$) [NC]
    RewriteRule ^ / [R=301,L]

    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php(?:[?\s]|$) [NC]
    RewriteRule ^ %1 [R=301,L,NE]


    # ------------------------------------------------------------------
    # Services main page (/services or /services/)
    # ------------------------------------------------------------------
    RewriteRule ^services/?$ services.php [L]


    # ------------------------------------------------------------------
    # Products main page (/products or /products/)
    # ------------------------------------------------------------------
    RewriteRule ^products/?$ products.php [L]


    # ------------------------------------------------------------------
    # Work & Projects page (/work or /projects)
    # ------------------------------------------------------------------
    RewriteRule ^work/?$ projects.php [L]
    RewriteRule ^projects/?$ projects.php [L]


    # ------------------------------------------------------------------
    # Services detail pages (/services/software-development, etc.)
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^services/([^/]+)/?$ services/$1.php [L]


    # ------------------------------------------------------------------
    # Products detail pages (/products/routeflow, etc.)
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^products/([^/]+)/?$ products/$1.php [L]


    # ------------------------------------------------------------------
    # Store pages & product detail (/store, /store/slug, /cart, /checkout, etc.)
    # ------------------------------------------------------------------
    RewriteRule ^store/?$ store.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^store/([^/]+)/?$ store-product.php?slug=$1 [L,QSA]

    RewriteRule ^cart/?$ cart.php [L]
    RewriteRule ^checkout/?$ checkout.php [L]
    RewriteRule ^wishlist/?$ wishlist.php [L]
    RewriteRule ^order-confirmation/?$ order-confirmation.php [L]


    # ------------------------------------------------------------------
    # Other root-level clean pages (/about, /contact, /guides, /privacy, etc.)
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # ------------------------------------------------------------------
    # Clean 404 Fallback for non-existent URLs
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ 404.php [L]

</IfModule>


# ==========================================================================
# Error page (Fallback for direct server errors)
# ==========================================================================

ErrorDocument 404 /404.php


# ==========================================================================
# Security headers
# ==========================================================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>


# ==========================================================================
# Protect sensitive files
# ==========================================================================

<FilesMatch "\.(jsonl|log|md|ini|yml|yaml|sql|bak|env)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ==========================================================================
# Compression
# ==========================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
    AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>


# ==========================================================================
# Caching
# ==========================================================================

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>


# ==========================================================================
# MIME types
# ==========================================================================

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg
</IfModule>