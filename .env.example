# =============================================================================
# Prospect Digital — Environment Configuration Template
# For Hostinger or Live Production:
#   1. Copy this file to .env  (in the same folder as index.php)
#   2. Fill in your Hostinger MySQL database and email/SMTP credentials.
# =============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false

# Canonical Site URL (Hostinger Domain, without trailing slash)
SITE_URL=https://prospectdigital.in

# -----------------------------------------------------------------------------
# Hostinger MySQL Database Credentials
# (Found in Hostinger hPanel -> Databases -> Management)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=u123456789_prospect
DB_USER=u123456789_prospect_user
DB_PASS=YourStrongDatabasePassword123!
DB_PORT=3306

# -----------------------------------------------------------------------------
# Email / Contact Form Configuration
# Options for MAIL_DRIVER:
#   smtp → Direct authenticated SMTP (recommended on Hostinger)
#   mail → PHP's built-in mail() function
#   log  → Store enquiries in MySQL and JSONL backup logs without sending email
# -----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM=hello@prospectdigital.in
MAIL_TO=hello@prospectdigital.in

# Hostinger SMTP Settings (Created in Hostinger hPanel -> Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@prospectdigital.in
SMTP_PASS=YourEmailAccountPassword123!
SMTP_ENCRYPTION=ssl
